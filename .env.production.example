APP_NAME=Hoxen
APP_ENV=production
# Générer la clé avec : php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://VOTRE-SITE.wasmer.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Base PostgreSQL distante (Wasmer). Le nom d'utilisateur et le mot de passe sont ceux du tableau de bord Wasmer.
DB_CONNECTION=pgsql
DB_HOST=psql.fr-roub1.bengt.wasmernet.com
DB_PORT=20184
DB_DATABASE=conciergerie_pg
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer

# Mots de passe des comptes créés par « php artisan db:seed » (sinon générés au hasard et affichés une fois)
SEED_ADMIN_PASSWORD=
SEED_HOST_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
